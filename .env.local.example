# App under test (forum-server local default)
BASE_URL=http://app.forum.test

# Locale path prefix used by Nuxt i18n (`en` | `vn`)
LOCALE=en

# Onboarded user for authenticated e2e flows (local defaults in tests/config/env.ts)
E2E_EMAIL=test@test.com
E2E_PASSWORD=test123456ABC@

# Optional second user (follow / directory interactions)
E2E_PEER_EMAIL=test2@test.com
E2E_PEER_PASSWORD=test123456ABC@2
E2E_PEER_URL_KEY=test2
